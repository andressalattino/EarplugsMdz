# Exclusivamente servidor. Nunca usar prefijos VITE_ para secretos.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa legacy a SUPABASE_SECRET_KEY: SUPABASE_SERVICE_ROLE_KEY
ADMIN_USERNAME=admin
# Ejecutar npm run admin:password para generar este valor.
ADMIN_PASSWORD_HASH=
# Dos secretos independientes, aleatorios, de al menos 32 caracteres.
SESSION_SECRET=
ANALYTICS_SECRET=
# Origen exacto sin barra final. En producción: https://tu-dominio.com
APP_ORIGIN=http://localhost:5173
